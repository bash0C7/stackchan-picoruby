#!/usr/bin/env ruby
# frozen_string_literal: true
#
# stackchan-ble-tui — interactive remote control for the StackChan BLE head.
#
# Holds a single BLE connection and sends one frame per typed command, so it
# is far snappier than re-invoking `stackchan-ble-control` per move (which
# rescans + reconnects every time). If the link drops while idle (Mac
# CoreBluetooth idle-disconnects after ~15-20s) the next command transparently
# reconnects — the device advertises continuously.
#
# Usage:
#   bundle exec stackchan-ble-tui [--name-prefix StackChan] [--device NAME]
#
# Commands (typed at the `stackchan>` prompt):
#   yl N        yaw toward StackChan's LEFT  (magnitude 0..100)
#   yr N        yaw toward StackChan's RIGHT (magnitude 0..100)
#   pu N        pitch UP                     (magnitude 0..100)
#   fwd         recentre: yaw 0 + pitch 0 (forward / level)
#   ton | toff  torque on / off
#   face NAME   set face (e.g. neutral, joy, closed)
#   t MS        move duration ms for subsequent yl/yr/pu/fwd (default 800)
#   h | help    show this help
#   q | quit    disconnect and exit

require "bundler/setup"
require "optparse"
require "stackchan_ble_client"

device_name = ENV.fetch("BLE_DEVICE_NAME", "StackChan-PicoRuby")
name_prefix = nil
OptionParser.new do |o|
  o.on("--device NAME")        { |v| device_name = v }
  o.on("--name-prefix PREFIX") { |v| name_prefix = v }
end.parse!(ARGV)

HELP = <<~TXT
  commands:
    yl N        yaw toward StackChan's LEFT  (0..100)
    yr N        yaw toward StackChan's RIGHT (0..100)
    pu N        pitch UP                     (0..100)
    fwd         forward / level (yaw 0 + pitch 0)
    ton | toff  torque on / off
    face NAME   set face (neutral, joy, closed, ...)
    t MS        move duration ms for subsequent moves (default 800)
    h | help    this help
    q | quit    disconnect and exit
TXT

client = StackchanBleClient::Client.new(device_name: device_name, name_prefix: name_prefix)

# Run a send block, reconnecting once if the link dropped while idle.
def with_link(client)
  yield
rescue StackchanBleClient::ConnectionError, StackchanBleClient::TimeoutError => e
  warn "[link] #{e.class}: #{e.message} — reconnecting"
  begin
    client.disconnect
  rescue StandardError => de
    warn "[link] disconnect during reconnect ignored: #{de.class}: #{de.message}"
  end
  client.connect
  yield
end

def magnitude(arg)
  n = Integer(arg, 10)
  raise ArgumentError, "magnitude must be 0..100, got #{n}" unless n.between?(0, 100)
  n
end

def show_detail(client)
  d = client.last_detail_frame
  puts "  detail: #{d.inspect}" if d
end

print "connecting... "
$stdout.flush
client.connect
puts "ok"
puts HELP

move_ms = 800
begin
  loop do
    print "\nstackchan> "
    $stdout.flush
    line = $stdin.gets
    break if line.nil? # EOF (Ctrl-D)
    cmd, arg = line.strip.split(/\s+/, 2)
    next if cmd.nil? || cmd.empty?

    begin
      case cmd
      when "yl"
        mag = magnitude(arg)
        with_link(client) { client.send { |s| s.head(yaw_left: mag, time_ms: move_ms) } }
        show_detail(client)
      when "yr"
        mag = magnitude(arg)
        with_link(client) { client.send { |s| s.head(yaw_right: mag, time_ms: move_ms) } }
        show_detail(client)
      when "pu"
        mag = magnitude(arg)
        with_link(client) { client.send { |s| s.head(pitch_up: mag, time_ms: move_ms) } }
        show_detail(client)
      when "fwd"
        with_link(client) { client.send { |s| s.head(yaw_left: 0, pitch_up: 0, time_ms: move_ms) } }
        show_detail(client)
      when "ton"
        with_link(client) { client.send { |s| s.torque(on: true) } }
      when "toff"
        with_link(client) { client.send { |s| s.torque(on: false) } }
      when "face"
        raise ArgumentError, "face requires a name" if arg.nil? || arg.empty?
        with_link(client) { client.send { |s| s.face(arg.to_sym) } }
      when "t"
        move_ms = Integer(arg, 10)
        puts "  move duration = #{move_ms} ms"
      when "h", "help"
        puts HELP
      when "q", "quit", "exit"
        break
      else
        puts "  unknown: #{cmd} (h for help)"
      end
    rescue ArgumentError => e
      puts "  error: #{e.message}"
    rescue StackchanBleClient::Error => e
      warn "  [FAIL] #{e.class}: #{e.message}"
    end
  end
ensure
  begin
    client.disconnect
    puts "\ndisconnected. bye"
  rescue StandardError => e
    warn "[disconnect] #{e.class}: #{e.message}"
  end
end
