#!/usr/bin/env ruby
require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "stackchan_ai_companion"

prompt = ARGV.join(" ")
prompt = $stdin.read.strip if prompt.empty? && !$stdin.tty?
abort "usage: stackchan-ai-companion <prompt>" if prompt.empty?

companion = StackchanAiCompanion::Companion.new
begin
  companion.connect
  reply = companion.respond(prompt)
  puts(reply) if reply
ensure
  companion.close
end
