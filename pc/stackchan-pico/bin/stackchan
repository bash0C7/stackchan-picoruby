#!/bin/sh
# StackChan PC-side CLI entry (PicoRuby edition).
#
# Attach only. The daemon and the AI/voice sidecar are launchd jobs; bring them
# up with `bundle exec rake pc:up` (see the deterministic-backend-lifecycle
# spec). This script deliberately does not probe, spawn or kill anything:
# deciding whether a resident process was usable is what produced the
# 2026-08-31 incidents (a busy daemon killed as wedged, an 8-day-stale stub
# sidecar, a healthy daemon killed over one transient DRb error), and the
# probing itself cost ~0.62s of CRuby startup on every command.
#
#   stackchan <verb> [args]
#
# Config via env (defaults target this dev checkout):
#   STACKCHAN_PICORUBY   path to the picoruby VM
#   STACKCHAN_ROOT       repo root (for the app boot scripts)
#   STACKCHAN_PORT       daemon drb port (default 8787)
set -eu

ROOT="${STACKCHAN_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}"
VM="${STACKCHAN_PICORUBY:-$ROOT/vendor/R2P2-darwin/build/host/bin/picoruby}"
PORT="${STACKCHAN_PORT:-8787}"

exec "$VM" "$ROOT/pc/stackchan-pico/app/boot_cli.rb" "$ROOT" "$PORT" "$@"
