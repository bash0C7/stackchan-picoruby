#!/usr/bin/env ruby
# frozen_string_literal: true

# PicoModem file uploader for R2P2 (PicoRuby shell).
#
# Two startup modes are tolerated:
#
#   (a) Shell-only mode (no autostart app.rb)
#       The R2P2 shell launches Editor#start, which calls
#       Editor.get_screen_size → IO.get_cursor_position → writes "\e[6n" and
#       blocks in STDIN.read_nonblock waiting for the 'R' terminator of the
#       cursor-position response. Until something replies, the editor never
#       enters its main loop and Ctrl-B (STX) is never delivered to
#       PicoModem.session. So we run a short responder phase that watches
#       inbound bytes and answers "\e[6n" → "\e[1;1R" (and "\e[5n" → "\e[0n").
#
#   (b) Autostart mode (~/app.rb is running)
#       The app owns STDIN; no editor is involved, no cursor query is sent,
#       so the responder simply sits idle and the bare STX byte is later
#       consumed by the app loop (in which case FILE_ACK won't come and the
#       upload will fail-fast with `FILE_ACK expected`). Fix: stop the app
#       first, e.g. `rake r2p2:flash` recovery → boot to shell.
#
# After the responder phase we send STX once to enter PicoModem.session,
# then perform FILE_WRITE handshake and stream CHUNK frames until DONE_ACK.
#
# Usage (from pc/stackchan-protocol):
#   bundle exec exe/picomodem-upload <src> <dst> [port]

require "uart"

SRC  = ARGV[0] || "mrbgems/picoruby-stackchan-protocol/examples/app.rb"
DST  = ARGV[1] || "/home/app.rb"
PORT = ARGV[2] || ENV["ESPPORT"] || "/dev/cu.usbmodem101"

STX        = 0x02
FILE_WRITE = 0x02
CHUNK      = 0x04
FILE_ACK   = 0x82
CHUNK_ACK  = 0x84
DONE_ACK   = 0x8F
CHUNK_SIZE = 480

# Boot + USB-CDC re-enumerate + editor init typically completes within
# ~5–7 s on CoreS3. Eight seconds gives margin without being painful.
HANDSHAKE_SECONDS = (ENV["UPLOAD_HANDSHAKE_SECONDS"] || "8.0").to_f

CURSOR_QUERY = "\e[6n"
CURSOR_REPLY = "\e[1;1R"
DSR_QUERY    = "\e[5n"
DSR_REPLY    = "\e[0n"

def crc16(data, crc = 0xFFFF)
  data.each_byte do |b|
    crc ^= b << 8
    8.times do
      crc = (crc & 0x8000) != 0 ? ((crc << 1) ^ 0x1021) & 0xFFFF : (crc << 1) & 0xFFFF
    end
  end
  crc
end

def make_frame(cmd, payload = "")
  body = [cmd].pack("C") + payload.b
  [STX, body.bytesize].pack("Cn") + body + [crc16(body)].pack("n")
end

def read_exact(io, n, timeout: 5.0)
  buf = +""
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
  while buf.bytesize < n
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    return nil if remaining <= 0
    return nil unless io.wait_readable(remaining)
    chunk = io.read(n - buf.bytesize)
    return nil if chunk.nil? || chunk.empty?
    buf << chunk
  end
  buf
end

def recv_frame(io, timeout: 5.0)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    return nil if remaining <= 0
    b = read_exact(io, 1, timeout: remaining)
    return nil unless b
    break if b.bytes[0] == STX
  end
  len_bytes = read_exact(io, 2, timeout: timeout)
  return nil unless len_bytes
  length = len_bytes.unpack1("n")
  rest = read_exact(io, length + 2, timeout: timeout)
  return nil unless rest
  body     = rest.byteslice(0, length)
  expected = rest.byteslice(length, 2).unpack1("n")
  return nil unless crc16(body) == expected
  [body.getbyte(0), body.byteslice(1, length - 1) || ""]
end

def run_handshake_responder(serial, duration)
  stop = false
  cursor_replies = 0
  dsr_replies    = 0
  buf = +""
  thr = Thread.new do
    while !stop
      if serial.wait_readable(0.05)
        begin
          chunk = serial.read_nonblock(256)
          buf << chunk if chunk && !chunk.empty?
          while (i = buf.index(CURSOR_QUERY))
            buf.slice!(0, i + CURSOR_QUERY.bytesize)
            serial.write CURSOR_REPLY
            cursor_replies += 1
          end
          while (i = buf.index(DSR_QUERY))
            buf.slice!(0, i + DSR_QUERY.bytesize)
            serial.write DSR_REPLY
            dsr_replies += 1
          end
          # Cap the buffer so a long boot can't grow it without bound.
          buf.slice!(0, buf.bytesize - 64) if buf.bytesize > 1024
        rescue IO::WaitReadable, EOFError
          # transient
        end
      end
    end
  end
  sleep duration
  stop = true
  thr.join
  [cursor_replies, dsr_replies]
end

content = File.binread(SRC)
puts "[uploader] src=#{SRC} dst=#{DST} port=#{PORT} size=#{content.bytesize}"

UART.open(PORT, 115_200) do |serial|
  puts "[uploader] handshake phase: #{HANDSHAKE_SECONDS}s (answers \\e[6n / \\e[5n so editor unblocks)"
  cur, dsr = run_handshake_responder(serial, HANDSHAKE_SECONDS)
  puts "[uploader] handshake done: cursor_replies=#{cur} dsr_replies=#{dsr}"

  # Drain anything still buffered from boot/banner/echo.
  while serial.wait_readable(0.1)
    begin
      drained = serial.read_nonblock(256)
      break if drained.nil? || drained.empty?
    rescue IO::WaitReadable, EOFError
      break
    end
  end

  # Single STX byte triggers PicoModem.session on the shell side.
  serial.write [STX].pack("C")
  sleep 0.05

  payload = [content.bytesize].pack("N") + DST
  serial.write make_frame(FILE_WRITE, payload)

  frame = recv_frame(serial, timeout: 5.0)
  unless frame && frame[0] == FILE_ACK
    abort "[uploader] FILE_ACK expected, got #{frame.inspect}"
  end
  puts "[uploader] FILE_ACK READY"

  offset = 0
  while offset < content.bytesize
    chunk = content.byteslice(offset, CHUNK_SIZE)
    serial.write make_frame(CHUNK, chunk)
    ack = recv_frame(serial, timeout: 5.0)
    unless ack && ack[0] == CHUNK_ACK
      abort "[uploader] CHUNK_ACK expected at offset=#{offset}, got #{ack.inspect}"
    end
    offset += chunk.bytesize
    print "."
    $stdout.flush
  end
  puts

  done = recv_frame(serial, timeout: 5.0)
  unless done && done[0] == DONE_ACK
    abort "[uploader] DONE_ACK expected, got #{done.inspect}"
  end
  puts "[uploader] DONE_ACK ok"
end
