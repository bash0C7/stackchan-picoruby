#!/bin/sh
# Refuse a push that would publish a pin nobody else can fetch.
#
# core.hooksPath points every tree here — this checkout and the vendored build
# trees — so the same guard runs whichever thing does the pushing: a terminal, an
# IDE, a rake task, or Claude. The Claude Code hook in .claude/settings.json
# covers the same ground one layer up and stays, because it can refuse before the
# command is even spawned; this one covers everything that never goes through it.
#
# Publishing a pin is itself a push, and this guard would block the one command
# that fixes it, so STACKCHAN_DEPS_GUARD=off in the environment stands the guard
# down for exactly that command.
[ "${STACKCHAN_DEPS_GUARD:-}" = "off" ] && exit 0

# $0 is <this repo>/.githooks/pre-push however the pushing tree is configured,
# which is what makes one hook serve all of them.
exec "$(cd "$(dirname "$0")/.." && pwd)/tools/check_deps_pushed.sh" --pins-only
