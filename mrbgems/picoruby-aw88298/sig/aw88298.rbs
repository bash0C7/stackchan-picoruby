class AW88298
  interface _Bus
    def write: (Integer i2c_adrs_7, *(Integer | String | Array[Integer]) outputs) -> Integer
  end

  interface _Sink
    def write: (String pcm) -> untyped
  end

  AW88298_ADDR: Integer
  AW_RATE_TBL: Array[Integer]

  def self.aw88298_reg06: (Integer sample_rate) -> Integer

  # Ordered init writes as [reg, hi, lo] triples.
  def self.aw88298_init_writes: (Integer sample_rate) -> Array[Array[Integer]]

  MULTICORE_CHUNK: Integer

  # G.711 mu-law -> little-endian 16-bit PCM.
  def self.ulaw_decode: (String ulaw) -> String

  @i2c: _Bus
  @i2s: _Sink

  attr_reader i2c: _Bus
  attr_reader i2s: _Sink

  def initialize: (i2c: _Bus, i2s: _Sink) -> void
  def init_amp: (Integer sample_rate) -> void
  def play_ulaw: (String ulaw) -> untyped
end
